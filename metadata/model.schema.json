{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded normalized metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "facts", "physicalObjects", "readiness"],
  "properties": {
    "version": { "enum": ["1.0.0"] },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "name", "text", "status", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["business-entity", "attribute-candidates", "source-assertion"] },
          "name": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["explicit-source", "source-proposal"] },
          "source": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "physicalObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "columns", "primaryKey", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "dataType", "nullable", "source"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "dataType": { "type": "string", "minLength": 1 },
                "nullable": { "type": "boolean" },
                "source": { "$ref": "#/$defs/sourceRef" }
              }
            }
          },
          "primaryKey": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "foreignKeys": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "referencedTable", "referencedColumns", "cardinality", "optional", "source"],
              "properties": {
                "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "referencedTable": { "type": "string", "minLength": 1 },
                "referencedColumns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "cardinality": { "enum": ["one-to-one", "many-to-one", "one-to-many", "many-to-many"] },
                "optional": { "type": "boolean" },
                "source": { "$ref": "#/$defs/sourceRef" }
              }
            }
          },
          "uniqueConstraints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "source"],
              "properties": {
                "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "source": { "$ref": "#/$defs/sourceRef" }
              }
            }
          },
          "checkConstraints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expression", "source"],
              "properties": {
                "expression": { "type": "string", "minLength": 1 },
                "source": { "$ref": "#/$defs/sourceRef" }
              }
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "unique", "source"],
              "properties": {
                "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "unique": { "type": "boolean" },
                "source": { "$ref": "#/$defs/sourceRef" }
              }
            }
          },
          "source": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false, "required": ["physical", "reason"],
      "properties": { "physical": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 } }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "line", "endLine"],
      "properties": {
        "section": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "readiness": { "properties": { "physical": { "const": true } }, "required": ["physical"] } },
        "required": ["readiness"]
      },
      "then": { "properties": { "physicalObjects": { "minItems": 1 } } },
      "else": { "properties": { "physicalObjects": { "maxItems": 0 } } }
    }
  ]
}
