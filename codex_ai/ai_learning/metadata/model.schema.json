{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded model",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        "1"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "title",
          "line"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "explicit"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "section",
              "line",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "status",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "attributeCandidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceFactId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed-in-source"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "attributeCandidates",
          "sourceFactId",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "physicalTables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "physicalReady": {
      "enum": [
        false
      ]
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "source",
    "sections",
    "facts",
    "entities",
    "physicalTables",
    "physicalReady",
    "ambiguities"
  ],
  "additionalProperties": false
}
